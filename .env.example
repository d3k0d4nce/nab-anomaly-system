# Docker Compose only: copy to .env and change values before exposing the dashboard.
# A local Python run reads real environment variables, not this file.
PGDATABASE=nab_anomaly
PGUSER=nab
PGPASSWORD=nab
NAB_HTTP_PORT=8081

# Session signing key. Use: python -c "import secrets; print(secrets.token_hex(32))"
NAB_SECRET_KEY=replace-with-random-64-hex
NAB_COOKIE_SECURE=0

# Demo accounts. Passwords are re-applied from env on app startup.
NAB_OPERATOR_LOGIN=operator
NAB_OPERATOR_PASSWORD=demo-operator
NAB_ADMIN_LOGIN=admin
NAB_ADMIN_PASSWORD=demo-admin

# auto = run only when DB/detectors are missing; 1 = force; 0 = skip.
NAB_RUN_PIPELINE=auto
